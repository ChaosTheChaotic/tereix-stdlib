use "std/sys/env/env";

// Returns an unowned/unallocated array of strings containg KV pairs of environment variables
*str getAllEnv() {
	ret env.environ;
}

// Returns the environment variable with the key of the given name, or null if the name is null
str getenv(str name) {
	if (name == null) {
		ret null;
	}
	ret env.getenv(name);
}

// Same as getenv but returns null with the restrictions of secure_getenv in C
str getenv_secure(str name) {
	if (name == null) {
		ret null;
	}
	ret env.secure_getenv(name);
}

// Sets the environment variable of the given name to the given value, optionally overwriting, returning the success status, or false if any values given are null
// The values of name and val are copied so lifetimes are irrelevant
bool setenv(str name, str val, bool overwrite) {
	if (name == null || val == null) {
		ret false;
	}
	ret env.setenv(name, val, overwrite) == 0;
}

// Unsets the environment variable at name, returning the success status, and false if given name is null (also true if name key does not exist in env)
bool unsetenv(str name) {
	if (name == null) {
		ret false;
	}
	ret env.unsetenv(name) == 0;
}
