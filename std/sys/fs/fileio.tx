extern {
	mut any fdopen(i32 fd, str mode);
	mut any fopen(str path, str mode);
	i64 ftell(mut any stream); // long can be i32 or i64 depending
	i32 fileno(mut any stream);
	i32 fputs(str s, mut any stream);
	size fwrite(any ptr, size size, size count, mut any stream);
	size fread(any ptr, size size, size count, mut any stream);
	i32 fflush(mut any stream);
	i32 fclose(mut any stream);
}
