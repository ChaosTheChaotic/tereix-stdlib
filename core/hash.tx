use "mem";

inline u64 read64(str p) {
	mut u64 v = 0;
	mem.cpy(&v, p, sizeof(u64));
	ret v;
}

inline u32 read32(str p) {
	mut u32 v = 0;
	mem.cpy(&v, p, sizeof(u32));
	ret v;
}

u64 rapid_mix(u64 A, u64 B) {
	mut u64 a_low = A & 0xFFFFFFFF;
	mut u64 a_high = A >> 32;
	mut u64 b_low = B & 0xFFFFFFFF;
	mut u64 b_high = B >> 32;

	mut u64 ll = a_low * b_low;
	mut u64 hl = a_high * b_low;
	mut u64 lh = a_low * b_high;
	mut u64 hh = a_high * b_high;

	mut u64 cross = ll >> 32 + hl & 0xFFFFFFFF + lh & 0xFFFFFFFF;
	mut u64 upper = hh + hl >> 32 + lh >> 32 + cross >> 32;
	mut u64 lower = cross << 32 | ll & 0xFFFFFFFF;

	ret upper ^ lower;
}

u64 rapidhash(str p, size len) {
	mut u64 seed = 0xb28b3231362eacc9;
	mut u64 a = 0;
	mut u64 b = 0;

	mut u64 sec0 = 0x2d358dccaa6c78a5;
	mut u64 sec1 = 0x8bb84b93962eacc9;
	mut u64 sec2 = 0x4b33a62ed433d4a3;

	seed ^= rapid_mix(seed ^ sec0, sec1) ^ (u64)len;

	mut str ptr = p;
	mut size rem = len;

	if (rem <= 16) {
		if (rem >= 4) {
			a = read32(ptr) << 32 | read32(ptr + (rem - 4));
			b = read32(ptr + (rem >> 1) - 2) << 32 | read32(ptr + (rem >> 1));
		} else if (rem > 0) {
			a = (u64)*ptr << 48 | (u64)ptr[rem >> 1] << 24 | (u64)ptr[rem - 1];
			b = 0;
		} else {
			a = 0;
			b = 0;
		}
		ret rapid_mix(seed ^ a, rem ^ b);
	}
	while (rem > 16) {
		a = read64(ptr);
		b = read64(ptr + 8);
		seed = rapid_mix(seed ^ a, sec1 ^ b);
		ptr += 16;
		rem -= 16;
	}

	a = read64(ptr + (rem - 16));
	b = read64(ptr + (rem - 8));
	ret rapid_mix(seed ^ a, sec2 ^ b);
}
