extern {
	mut any malloc(size size);
	mut any calloc(size n, size size);
	mut any realloc(mut any p, size size);

	void free(mut any p);
	
	mut any memcpy(mut any dest, any src, size n);
	mut any memset(mut any s, i32 c, size n);
	mut any memmove(mut any dest, any src, size n);
	i32 memcmp(any s1, any s2, size n);
}
